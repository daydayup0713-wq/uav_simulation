# Extends the existing headless SITL image; rendered sensors remain a host gate.
ARG LAB_BASE=uav-lab
FROM ${LAB_BASE}
RUN apt-get update && apt-get install -y --no-install-recommends \
      nlohmann-json3-dev python3-psutil python3-websockets && \
    rm -rf /var/lib/apt/lists/*
RUN ./scripts/env.sh /usr/bin/python3 scripts/bootstrap_backends.py --backend glim --jobs 2
RUN ./scripts/env.sh /usr/bin/python3 scripts/bootstrap_planners.py --backend ego --jobs 2
RUN ./scripts/env.sh /usr/bin/python3 scripts/bootstrap_planners.py --backend fast_planner --jobs 2
RUN ./scripts/env.sh /usr/bin/python3 scripts/bootstrap_planners.py --backend gcopter --jobs 2
CMD ["./scripts/env.sh", "/usr/bin/python3", "scripts/ci_workbench.py", "--output", ".runtime/ci-workbench"]

diff --git a/src/fast_livo/include/platform_cloud_transform.hpp b/src/fast_livo/include/platform_cloud_transform.hpp
new file mode 100644
index 0000000..ed95221
--- /dev/null
+++ b/src/fast_livo/include/platform_cloud_transform.hpp
@@ -0,0 +1,15 @@
+#pragma once
+#include <pcl/common/transforms.h>
+
+namespace platform_io {
+inline void appendKeyframeCloud(const pcl::PointCloud<pcl::PointXYZRGB>& frame,
+                               const Eigen::Affine3f& transform,
+                               pcl::PointCloud<pcl::PointXYZRGB>& global) {
+    // PCL 1.12 transformPointCloud assigns with the incoming width. A valid
+    // empty RGB frame has width=0, causing integer division by zero there.
+    if (frame.empty()) return;
+    pcl::PointCloud<pcl::PointXYZRGB> transformed;
+    pcl::transformPointCloud(frame, transformed, transform);
+    global += transformed;
+}
+}

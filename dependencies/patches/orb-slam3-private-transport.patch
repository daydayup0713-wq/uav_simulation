diff --git a/src/System.cc b/src/System.cc
index 60d9c51..8f44e32 100644
--- a/src/System.cc
+++ b/src/System.cc
@@ -1547,3 +1547,55 @@ string System::CalculateCheckSum(string filename, int type)
 
 } //namespace ORB_SLAM
 
+
+// Platform observation accessor: call immediately after TrackMonocular on its owner thread.
+// No estimator state or optimization is changed.
+namespace ORB_SLAM3 {
+bool System::GetMetricImuPose(Eigen::Matrix4f& pose, int& map_id,
+                              Eigen::Matrix4f* previous_pose, double* previous_stamp) {
+    if (GetTrackingState()!=Tracking::OK) return false;
+    auto map=mpAtlas->GetCurrentMap();
+    if (!map) return false;
+    unique_lock<mutex> lock(map->mMutexMapUpdate);
+    if (!map->isImuInitialized()) return false;
+    map_id=static_cast<int>(map->GetId());
+    pose=mpTracker->mCurrentFrame.GetImuPose().matrix();
+    if (previous_pose) previous_pose->setConstant(std::numeric_limits<float>::quiet_NaN());
+    if (previous_stamp) *previous_stamp=std::numeric_limits<double>::quiet_NaN();
+    // Reconstruct the last two frames against the *current* keyframe poses,
+    // using the same culled-keyframe traversal as SaveTrajectoryEuRoC.
+    // This exposes observations only; estimator math/state are unchanged.
+    auto& poses=mpTracker->mlRelativeFramePoses;
+    auto& refs=mpTracker->mlpReferences;
+    auto& times=mpTracker->mlFrameTimes;
+    auto& lost=mpTracker->mlbLost;
+    if (previous_pose && previous_stamp && poses.size()>=2 &&
+        refs.size()==poses.size() && times.size()==poses.size() && lost.size()==poses.size()) {
+        auto p=poses.rbegin(); auto r=refs.rbegin(); auto t=times.rbegin(); auto l=lost.rbegin();
+        auto reconstruct=[&](const Sophus::SE3f& relative, KeyFrame* reference, bool failed,
+                             Eigen::Matrix4f& result) {
+            if (failed || !reference) return false;
+            Sophus::SE3f chain;
+            int traversed=0;
+            while (reference->isBad()) {
+                if (++traversed>10000) return false;
+                chain=chain*reference->mTcp;reference=reference->GetParent();
+                if (!reference) return false;
+            }
+            if (reference->GetMap()!=map) return false;
+            result=((relative*chain*reference->GetPose()).inverse()*
+                    mpTracker->mCurrentFrame.mImuCalib.mTcb).matrix();
+            return result.allFinite();
+        };
+        Eigen::Matrix4f current, previous;
+        if (std::abs(*t-mpTracker->mCurrentFrame.mTimeStamp)<1e-6 &&
+            reconstruct(*p,*r,*l,current)) {
+            ++p;++r;++t;++l;
+            if (reconstruct(*p,*r,*l,previous)) {
+                pose=current;*previous_pose=previous;*previous_stamp=*t;
+            }
+        }
+    }
+    return pose.allFinite();
+}
+}

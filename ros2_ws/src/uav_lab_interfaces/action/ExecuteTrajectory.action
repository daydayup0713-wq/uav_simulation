std_msgs/Header header
string trajectory_id
# Empty for new motion; replacement must name the currently active trajectory.
string replaces_id
uav_lab_interfaces/TrajectorySegment[<=128] segments
bool navigation
uint64 navigation_epoch
---
bool success
string reason
---
string phase
geometry_msgs/PoseStamped current_pose
uav_lab_interfaces/TrajectoryReference reference

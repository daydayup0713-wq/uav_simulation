    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.3 0.2 -0.9</direction><diffuse>0.9 0.9 0.9 1</diffuse></light>
    <model name="ground"><static>true</static><link name="ground_link">
